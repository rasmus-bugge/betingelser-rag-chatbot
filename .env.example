# .env.example
# A TEMPLATE showing which settings the project needs. Copy it to `.env` and fill
# in real values. `.env` is never committed to git.

# The address of the PostgreSQL database (with the pgvector extension installed):
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# OpenRouter API key, used to create embeddings (https://openrouter.ai)
OPENROUTER_API_KEY=
