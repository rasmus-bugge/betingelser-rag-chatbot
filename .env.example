# .env.example
# A TEMPLATE showing which settings the project needs. Copy it to `.env` and fill
# in real values. `.env` is never committed to git.

# The address of the PostgreSQL database (with the pgvector extension installed):
# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=

# OpenRouter API key, used for embeddings and the language model (https://openrouter.ai)
OPENROUTER_API_KEY=

# Which vector store the search uses: "pgvector" (local Postgres, the default)
# or "qdrant" (Qdrant Cloud).
VECTOR_STORE=pgvector

# Qdrant Cloud: the cluster address and its API key (https://cloud.qdrant.io)
QDRANT_ENDPOINT=
QDRANT_API_KEY=

# Claude API key, for the step where Claude writes the answer (not used yet)
ANTHROPIC_API_KEY=
